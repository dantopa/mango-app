<?xml version="1.0" encoding="utf-8"?>
<!-- Static stand-in for the painted bar, so the widget picker's preview has one. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#2A2A31" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:end="170dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#22C55E" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
