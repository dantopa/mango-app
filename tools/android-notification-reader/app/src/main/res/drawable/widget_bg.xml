<?xml version="1.0" encoding="utf-8"?>
<!-- The card. A faint top-to-bottom gradient and a hairline border keep it from
     reading as a flat black rectangle on a dark wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#0D0D0F"
        android:startColor="#18181B" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#2A2A31" />
</shape>
