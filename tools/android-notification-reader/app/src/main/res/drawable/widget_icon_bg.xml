<?xml version="1.0" encoding="utf-8"?>
<!-- Round press feedback for the eye. Our own instead of ?selectableItemBackground:
     theme attributes are resolved by the launcher, not by this app. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</ripple>
