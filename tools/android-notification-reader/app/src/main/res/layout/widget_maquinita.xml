<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout of the summary widget. Only classes RemoteViews can inflate are used —
  which is why there is no <View> or <Space> here: the weighted TextViews do the
  spacing. The tools:text values are only samples for the layout editor; the
  renderer sets every string, so nothing here is shipped as real text.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- Header: status dot, month, eye. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/state_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dot_positive" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="Octubre"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="día 12 de 31"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="14:35"
                android:textColor="@color/widget_tertiary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/btn_privacy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_icon_bg"
                android:contentDescription="@string/widget_hide_values"
                android:padding="5dp"
                android:src="@drawable/ic_eye" />
        </LinearLayout>

        <!-- The figure: spent, of the ceiling, percent. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/spent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="US$ 1.184"
                android:textColor="@color/widget_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/of_ceiling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="de US$ 3.100"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="38%"
                android:textColor="@color/tone_positive"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Budget bar, painted at the widget's real width. -->
        <ImageView
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_preview" />

        <!-- Flexible gap: the content breathes on tall widgets and tightens on short ones. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <!-- Footer: today's allowance and the last purchase. The first column is as
             wide as its label; the second takes the rest, so a long merchant name has
             room and is the thing that gets cut — never the amount. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/daily_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:textColor="@color/widget_tertiary"
                    android:textSize="10sp"
                    tools:text="HOY PODÉS GASTAR" />

                <TextView
                    android:id="@+id/daily_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp"
                    tools:text="US$ 96" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/last_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:textColor="@color/widget_tertiary"
                    android:textSize="10sp"
                    tools:text="ÚLTIMO · HOY 14:32" />

                <!-- Merchant on the left, amount on the right edge like a receipt line. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/last_merchant"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_text"
                        android:textSize="15sp"
                        tools:text="Rappi" />

                    <TextView
                        android:id="@+id/last_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_text"
                        android:textSize="15sp"
                        tools:text="US$ 12,40" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
