<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). Foreground is the PWA's maskable icon, background is
     the PWA theme colour, so launcher and web app look like the same product. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/theme_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
