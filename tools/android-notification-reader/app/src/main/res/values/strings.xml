<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Maquinita</string>
    <string name="reader_config">Lector de notificaciones</string>

    <!--
      The site the TWA opens. Changing the domain means changing twa_host, the
      site in asset_statements, and public/.well-known/assetlinks.json together.
    -->
    <string name="twa_url" translatable="false">https://mango-app-phi.vercel.app</string>
    <string name="twa_host" translatable="false">mango-app-phi.vercel.app</string>

    <!-- App half of the Digital Asset Links pair. Must match the served file. -->
    <string name="asset_statements" translatable="false">
        [{
          \"relation\": [\"delegate_permission/common.handle_all_urls\"],
          \"target\": {
            \"namespace\": \"web\",
            \"site\": \"https://mango-app-phi.vercel.app\"
          }
        }]
    </string>

    <string name="setup_intro">Dos pasos: vinculá el teléfono y dale acceso a las notificaciones. No hay nada que escribir.</string>
    <string name="pair_device">Vincular este teléfono</string>
    <string name="grant_access">Dar acceso a notificaciones</string>
    <string name="send_test">Enviar prueba</string>
    <string name="refresh">Actualizar estado</string>
    <string name="pairing_started">Abriendo el navegador para aprobar…</string>
    <string name="pairing_failed">No se pudo vincular: %1$s</string>
    <string name="not_paired">Primero vinculá el teléfono</string>
    <string name="test_queued">Prueba encolada</string>

    <!-- Shown by LauncherActivity before the dashboard when the sensor is not usable. -->
    <string name="sensor_warning_title">El lector de gastos está apagado</string>
    <string name="sensor_not_paired">Este teléfono todavía no está vinculado, así que tus compras no se están registrando.</string>
    <string name="sensor_no_access">Falta el acceso a notificaciones, así que tus compras no se están registrando.</string>
    <string name="sensor_fix">Arreglarlo</string>
    <string name="sensor_ignore">Ver el panel igual</string>
</resources>
