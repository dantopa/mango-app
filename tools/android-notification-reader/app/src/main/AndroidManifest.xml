<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The sensor's watchdog (SensorService). specialUse rather than dataSync
      because the Android 15 timeout caps dataSync at 6 h/day and this has to
      outlive that; the subtype below is the declaration that goes with it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only to show the sensor's status; nothing here alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup is off on purpose: the ingest bearer token lives in this app's
      SharedPreferences and must not travel to Google's backup.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <!--
          Digital Asset Links, app half. The site half is served from
          /.well-known/assetlinks.json; Chrome checks both match before it hides
          the URL bar. Without the pair, the TWA still works but looks like a
          browser tab.
        -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!--
          The launcher IS the PWA: Chrome renders it full screen, sharing the
          browser's session, service worker and web push. Updating the site
          updates the app, so there is nothing to reinstall.

          Our own subclass, only so it can warn before opening a dashboard whose
          sensor is off — Android's notification-listener state is invisible to the
          page Chrome renders.
        -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/twa_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/theme_background" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/theme_background" />

            <!--
              Splash screen. Without it the launch is a translucent window followed
              by an empty Chrome viewport, which reads as a broken app; with it the
              logo is on screen from the first frame and the *browser* holds it
              until the page paints, then fades. That handoff is why the image has
              to be shareable — hence the FileProvider below.
            -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@mipmap/ic_launcher_foreground" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/theme_background" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="com.maquinita.reader.fileprovider" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Opening a link to the app's own domain opens the app, not Chrome. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="@string/twa_host"
                    android:scheme="https" />
            </intent-filter>

            <!-- Long-press the icon to reach the reader config. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Reader config. No longer the launcher, and not exported: it is reached
          from the app shortcut, so nothing outside the app can open the screen
          that shows the endpoint and the token.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/reader_config" />

        <!--
          Only exists to hand the splash image to Chrome. Not exported and scoped
          to one directory (@xml/filepaths), so it is not a way into this app's
          files: the URI is granted per launch, to the browser, for one PNG.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.maquinita.reader.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!--
          Bound by the system, so it must be exported; the BIND permission is what
          keeps other apps from binding it.
        -->
        <service
            android:name=".NotificationReaderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Watchdog for the service above. Not exported: only this app starts it.
        -->
        <service
            android:name=".SensorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors that the notification listener is still bound so expense capture cannot fail silently." />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
