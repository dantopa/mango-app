# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Public client env IS committed so Vercel git-integration builds work with zero
# config. These NEXT_PUBLIC_ values ship in the browser bundle anyway (the
# Supabase publishable key is public; RLS is the security boundary). The service
# role key is NEVER committed.
!.env.production

# supabase (CLI local cache — linked project ref, tool versions)
supabase/.temp/

# kiro
# .kiro/

# vercel
.vercel

# android reader (gradle build output + local SDK path)
# Signing config: the keystore itself lives in ~/.android/, outside the repo, so
# only the pointer file could ever leak. It holds the keystore password.
tools/android-notification-reader/keystore.properties
tools/android-notification-reader/*.keystore
tools/android-notification-reader/.gradle/
tools/android-notification-reader/build/
tools/android-notification-reader/app/build/
tools/android-notification-reader/local.properties
tools/android-notification-reader/gradle/wrapper/gradle-wrapper.jar
tools/android-notification-reader/gradlew
tools/android-notification-reader/gradlew.bat

# typescript
*.tsbuildinfo
next-env.d.ts
.mcp.json
